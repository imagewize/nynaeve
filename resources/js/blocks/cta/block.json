{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "imagewize/cta",
    "version": "1.0.0",
    "title": "CTA",
    "category": "nynaeve/cta",
    "icon": "megaphone",
    "description": "Blog-post call-to-action. Pick a service variant from the inserter.",
    "keywords": ["cta", "call to action"],
    "example": { "attributes": { "variant": "wordpress-development" } },
    "textdomain": "nynaeve",
    "style": "file:./style.css",
    "editorStyle": "file:./editor.css",
    "supports": {
        "align": ["wide", "full"],
        "anchor": true,
        "spacing": {
            "margin": true,
            "padding": true
        },
        "color": false,
        "html": false
    },
    "attributes": {
        "variant": {
            "type": "string",
            "default": "wordpress-development"
        },
        "style": {
            "type": "object",
            "default": { "spacing": { "margin": { "top": "0", "bottom": "0" } } }
        }
    }
}
